# Backlog Configuration
BACKLOG_SPACE_ID=ohchans
BACKLOG_DOMAIN=backlog.jp
BACKLOG_API_KEY=your_backlog_api_key_here

# 監視対象: プロジェクトキー (プロジェクト配下の条件一致チケットを自動走査)
BACKLOG_PROJECT_KEY=STUDY

# 特定の単一チケットのみに限定したい場合のみ指定 (省略時はプロジェクト配下全件スキャン)
# BACKLOG_ISSUE_KEY=STUDY-3

# デフォルト作業リポジトリ (チケット詳細にリポジトリ記載がない場合のフォールバック)
DEFAULT_REPO_PATH=./

# 作業ディレクトリ & ワークツリー管理
# AIDEVFLOW_HOME=~/aidevflow

# Daemon Configuration
POLL_INTERVAL_SEC=10
MAX_REJECTION_COUNT=3
DRY_RUN=false
LOG_FILE_PATH=logs/aidevflow.jsonl

# Agent Runner Configuration: agy (Antigravity CLI), claude, or mock
AGENT_RUNNER=agy
AGY_EFFORT=medium
AGENT_WORKDIR=./

