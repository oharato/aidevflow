# Backlog Configuration
BACKLOG_SPACE_ID=ohchans
BACKLOG_DOMAIN=backlog.jp
BACKLOG_API_KEY=your_backlog_api_key_here

# 監視対象: プロジェクトキー (プロジェクト配下の条件一致チケットを自動走査)
BACKLOG_PROJECT_KEY=STUDY

# 特定の単一チケットのみに限定したい場合のみ指定 (省略時はプロジェクト配下全件スキャン)
# BACKLOG_ISSUE_KEY=STUDY-3

# チケットフィルタリング設定 (ドラフト保護 & 通常タスクとの共存用)
# 指定した種別 (例: AI開発, タスク) のチケットのみを対象にする場合
# TARGET_ISSUE_TYPE=AI開発

# 指定したカテゴリー (例: AIパイプライン) のチケットのみを対象にする場合
# TARGET_CATEGORY=AI開発

# 件名や本文に [AI] タグが含まれるチケットのみを対象にする場合 (true / false)
# REQUIRE_AI_TAG=false

# デフォルト作業リポジトリ (チケット詳細にリポジトリ記載がない場合のフォールバック)
DEFAULT_REPO_PATH=./

# 作業ディレクトリ & ワークツリー管理
# AIDEVFLOW_HOME=~/aidevflow

# Daemon Configuration
POLL_INTERVAL_SEC=10
MAX_REJECTION_COUNT=3
DRY_RUN=false
LOG_FILE_PATH=logs/aidevflow.jsonl

# Agent Runner Configuration:
# - agy: Google Antigravity CLI (デフォルト本番)
# - mock: Backlog連携テスト用モック (LLM不使用・トークン消費ゼロでステータス遷移やPR作成の動作確認が可能)
# - claude: Anthropic Claude Code
AGENT_RUNNER=agy
# モデル指定 (gemini-3.8-flash-high, gemini-3.8-flash-medium, gemini-3.1-pro-high 等)
AGY_MODEL=gemini-3.8-flash-high
# レビュー用モデル (省略時は AGY_MODEL を使用)
AGY_REVIEW_MODEL=gemini-3.8-flash-medium
AGY_EFFORT=low
AGENT_WORKDIR=./
