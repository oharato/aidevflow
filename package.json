{
  "name": "aidevflow",
  "version": "0.1.0",
  "description": "Backlog-driven AI Agent Pipeline Daemon",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "test": "tsx test/repo-parser.test.ts && tsx test/worktree.test.ts && tsx test/github.test.ts && tsx test/dispatcher.test.ts && tsx test/poller.test.ts && tsx test/loop-prevention.test.ts",
    "setup:statuses": "tsx src/scripts/setup-statuses.ts"
  },
  "packageManager": "pnpm@11.22.0",
  "dependencies": {
    "dotenv": "17.4.2"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
