{
  "name": "aidevflow",
  "version": "0.1.0",
  "description": "Backlog-driven AI Agent Pipeline Daemon",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
