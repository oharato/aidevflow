    "test:watch": "vitest",
    "setup:statuses": "tsx src/scripts/setup-statuses.ts"
  },
  "packageManager": "pnpm@11.22.0",
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
